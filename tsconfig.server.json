  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-server",
    "rootDir": "src",
    "noEmit": false,
    "jsx": "react-jsx"
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts"]
}
